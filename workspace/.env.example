# ---- Database (Supabase Postgres, free tier) ----
# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection, used by prisma migrate / db push.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Supabase Auth + Storage ----
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"
# Storage bucket holding casebook PDFs. Create it as a private bucket.
NEXT_PUBLIC_SUPABASE_BUCKET="casebooks"

# ---- Outgoing mail (the Contact me form) ----
# Gmail with an app password is the intended setup: free, and the same kind of
# credential Supabase Auth uses for its own mail. Create the app password at
# myaccount.google.com/apppasswords with 2-Step Verification switched on.
# Leave these unset and the form still works — messages are stored in the
# FeedbackMessage table with the reason they could not be sent.
# SMTP_USER="casedeskadmin@gmail.com"
# SMTP_PASS="<16-character app password>"
# Defaults below are Gmail's; only set them for another provider.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# Where the contact form goes. Defaults to casedeskadmin@gmail.com.
# FEEDBACK_TO="casedeskadmin@gmail.com"

# ---- Seeding ----
SEED_ADMIN_EMAIL="you@university.edu"
SEED_ADMIN_NAME="Your Name"
# Set to skip the demo case and candidate.
# SEED_MINIMAL=1

# ---- Local development without a Supabase project ----
# Every request is treated as this coach. Ignored when NODE_ENV=production.
# DEV_COACH_EMAIL="you@university.edu"
