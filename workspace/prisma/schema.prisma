// Case Desk — see case-desk-spec.md §3.
// Postgres (Supabase). Enums are real Postgres enums.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String      @id @default(cuid())
  email      String      @unique
  name       String
  role       Role        @default(COACH)
  createdAt  DateTime    @default(now())
  // Optional personal Anthropic key seam (§7.1). Never used in v1.
  sessions   Session[]
  ownedCases Case[]
  coachCases CoachCase[]
  casebooks  Casebook[]
  candidates  Candidate[] @relation("CandidateCreator")
  caseRatings CaseRating[]
  feedback    FeedbackMessage[]
  invitesSent Invite[]    @relation("InviteSender")
}

/// A message from the contact form.
///
/// Kept as well as emailed. Mail is the fragile half of this feature — an app
/// password gets revoked, a provider decides the login looks suspicious — and
/// a message nobody can read afterwards is worse than one that arrives late.
/// If sending fails the row is still here, with the reason on it.
model FeedbackMessage {
  id        String    @id @default(cuid())
  /// The address the sender typed. Unverified, and not necessarily an account.
  fromEmail String
  body      String
  /// Set when whoever wrote it happened to be signed in.
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  sentAt    DateTime?
  sendError String?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

enum Role {
  ADMIN
  COACH
}

/// Retired. Sign-up is open now — anyone who confirms an email address gets a
/// coach seat, and ADMIN is granted by an admin rather than pre-assigned here.
/// Nothing reads this table; it is still declared so that the schema and the
/// database agree. Drop it with:
///   npx prisma db push --accept-data-loss
model Invite {
  id         String    @id @default(cuid())
  email      String    @unique
  role       Role      @default(COACH)
  invitedById String
  invitedBy  User      @relation("InviteSender", fields: [invitedById], references: [id])
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// ---------- Library ----------

model Casebook {
  id         String   @id @default(cuid())
  title      String
  school     String?
  year       Int?
  fileKey    String
  /// "PDF" or "IMAGES" — an image set is normalised to a page sequence (§4.1).
  sourceKind SourceKind @default(PDF)
  /// For IMAGES sources: ordered storage keys, one per page.
  imageKeys  String[]   @default([])
  pageCount  Int
  /// Extracted per-page text, indexed by page number: { "1": "...", "2": "..." }
  pageText   Json?
  /// Denormalised lowercase concatenation of pageText, so library search can
  /// hit the casebook body without a JSON scan (§5).
  searchText String?
  /// Bytes stored, for the 1GB free-tier capacity warning (§10).
  byteSize   Int      @default(0)
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  createdAt  DateTime @default(now())
  cases      Case[]
}

enum SourceKind {
  PDF
  IMAGES
}

model Case {
  id         String   @id @default(cuid())
  casebookId String?
  casebook   Casebook? @relation(fields: [casebookId], references: [id], onDelete: Cascade)
  title      String
  startPage  Int?
  endPage    Int?

  caseType    CaseType
  industry    String?
  targetRound TargetRound?
  format      CaseFormat @default(INTERVIEWER_LED)
  /// The consulting firm this case comes from or imitates the style of.
  /// Free text with suggestions rather than an enum — firms merge, rebrand,
  /// and a club will want school-specific entries an enum could not hold.
  firm        String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  // Attributes of the case itself, 1-5.
  //
  // These are no longer anybody's opinion: each one is the mean of every
  // coach's rating in CaseRating, recomputed on write. They live here rather
  // than being derived on read so that the library's filters and sorts stay
  // ordinary SQL. Float, because an average of 4 and 3 is 3.5.
  quantIntensity      Float?
  creativityLoad      Float?
  structureDifficulty Float?
  ambiguity           Float?
  dataDensity         Float?
  overallDifficulty   Float?

  /// Verdict on the case as a teaching tool, not a property of its content.
  /// Also a mean of CaseRating.
  caseQuality Float?

  /// How many coaches have rated this case at all. Cached alongside the means
  /// so a library row can say what it is an average of without a join.
  ratingCount Int @default(0)

  notes     String?
  archived  Boolean  @default(false)
  /// The shop window. An admin picks which cases a signed-out visitor may
  /// read; everything else shows as a blurred placeholder. Only sectioned,
  /// unarchived cases are eligible — running an unsectioned case writes a
  /// section back to the library, which is not a visitor's to do.
  sampleForGuests Boolean @default(false)
  createdAt DateTime @default(now())

  sections   Section[]
  sessions   Session[]
  coachCases CoachCase[]
  ratings    CaseRating[]

  @@index([casebookId])
  @@index([ownerId])
}

/// One coach's view of one case, 1-5 per attribute.
///
/// Ratings used to belong to whoever added the case, which made the library's
/// numbers one person's taste. Every coach rates now, and what the library
/// shows is the average. Every field is optional: rating quant intensity
/// without an opinion on ambiguity is normal, and each attribute averages over
/// the people who actually answered it.
model CaseRating {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  quantIntensity      Int?
  creativityLoad      Int?
  structureDifficulty Int?
  ambiguity           Int?
  dataDensity         Int?
  overallDifficulty   Int?
  caseQuality         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, caseId])
  @@index([caseId])
}

enum CaseType {
  PROFITABILITY
  MARKET_ENTRY
  MA
  GROWTH
  PRICING
  COST_REDUCTION
  OPERATIONS
  MARKET_SIZING
  NEW_PRODUCT
  OTHER
}

enum TargetRound {
  SCREENING
  FIRST_ROUND
  FINAL_ROUND
}

enum CaseFormat {
  INTERVIEWER_LED
  INTERVIEWEE_LED
}

model Section {
  id         String      @id @default(cuid())
  caseId     String
  case       Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind       SectionKind
  label      String
  order      Int
  startPage  Int?
  endPage    Int?
  bodyText   String?
  isSolution Boolean     @default(false)
  targetMins Int?

  /// Companion section shown alongside this one in the runner: the prompt that
  /// belongs to an exhibit, or the sample framework that belongs to a prompt.
  /// A paired section keeps its own notes but never gets its own slot in the
  /// section sequence — it surfaces with its partner instead.
  pairedWithId String?
  pairedWith   Section?  @relation("SectionPairing", fields: [pairedWithId], references: [id], onDelete: SetNull)
  pairedBy     Section[] @relation("SectionPairing")

  @@index([caseId, order])
  @@index([pairedWithId])
}

enum SectionKind {
  PROMPT
  CLARIFYING
  STRUCTURE
  EXHIBIT
  EXHIBIT_PROMPT
  MATH
  BRAINSTORM
  SYNTHESIS
  INTERVIEWER_GUIDE
}

/// One row per (coach, case). Readiness state plus private scratch notes.
model CoachCase {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  state ReadinessState @default(UNREAD)

  /// Private. Never shown to other coaches, never in candidate reports.
  personalNotes String?

  lastDeliveredAt DateTime?
  updatedAt       DateTime @updatedAt

  @@unique([userId, caseId])
  @@index([userId])
}

enum ReadinessState {
  UNREAD
  READ
  PRACTICED
  DELIVERED
}

// ---------- Sessions ----------

model Candidate {
  id        String    @id @default(cuid())
  /// The coach who added this candidate. Coaches see only their own; admins
  /// see everyone (deliberately narrower than spec §2, at the club's request).
  /// Nullable so a candidate outlives the account that created them.
  createdById String?
  createdBy   User?   @relation("CandidateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  name      String
  email     String?
  cohort    String?
  year      String?
  notes     String?
  archived  Boolean   @default(false)
  createdAt DateTime  @default(now())
  sessions  Session[]

  @@index([createdById])
}

model Session {
  id          String    @id @default(cuid())
  caseId      String
  /// Deleting a casebook cascades to its cases and their sessions (§8.1).
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  coachId     String
  coach       User      @relation(fields: [coachId], references: [id])
  /// Set when a signed-out visitor ran this session. It holds the random id
  /// from their browser cookie, which is the only thing that makes the session
  /// theirs — there is no account to hang it on. Coaches' lists exclude any
  /// session carrying one.
  guestKey    String?

  status       SessionStatus @default(IN_PROGRESS)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  totalSeconds Int?

  locked     Boolean   @default(false)
  reopenedAt DateTime?
  archived   Boolean   @default(false)

  /// Unguessable, revocable public read-only link (§8).
  shareToken String? @unique

  scores       Score[]
  sectionNotes SectionNote[]
  takeaways    Takeaway[]
  overallNote  String?
  /// What the report includes (§8). Every part is on by default; the coach
  /// turns pieces off in the dialog before generating.
  includeScores      Boolean @default(true)
  includeTakeaways   Boolean @default(true)
  includeOverall     Boolean @default(true)
  /// The coaching notes written during the case, section by section.
  includeFeedback    Boolean @default(true)
  /// The record of what the candidate actually said.
  includeWhatWasSaid Boolean @default(true)
  /// Suppress the casebook source line in the report.
  hideSource         Boolean @default(false)
  sharedAt      DateTime?

  @@index([candidateId])
  @@index([caseId])
  @@index([coachId, status])
  @@index([guestKey])
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETE
  ABANDONED
}

model SectionNote {
  id           String  @id @default(cuid())
  sessionId    String
  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sectionId    String
  whatWasSaid  String  @default("")
  feedback     String  @default("")
  secondsSpent Int     @default(0)

  @@unique([sessionId, sectionId])
}

model Score {
  id        String    @id @default(cuid())
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  dimension Dimension
  value     Int

  @@unique([sessionId, dimension])
}

enum Dimension {
  STRUCTURE
  QUANTITATIVE
  JUDGMENT
  SYNTHESIS
  PRESENCE
}

model Takeaway {
  id        String       @id @default(cuid())
  sessionId String
  session   Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind      TakeawayKind
  rank      Int
  text      String

  @@unique([sessionId, kind, rank])
}

enum TakeawayKind {
  CONTINUE
  IMPROVE
}

// ---------- Phrase bank (powers non-AI feedback drafting) ----------

model Phrase {
  id        String       @id @default(cuid())
  dimension Dimension
  band      Band
  kind      TakeawayKind
  text      String
  active    Boolean      @default(true)

  @@index([dimension, band, kind, active])
}

enum Band {
  LOW
  MID
  HIGH
}
